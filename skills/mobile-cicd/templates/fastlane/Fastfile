# frozen_string_literal: true

# Generated by @@generator@@. Settings: .github/mobile-cicd/config.json
# Lanes for .github/workflows/mobile-release.yml. They read the secrets from environment
# variables the workflow sets; nothing secret is written into the repo.
#
#   fastlane next_build_number   highest build number in either store, plus one
#   fastlane ios release         sign, build and upload the .ipa to App Store Connect
#   fastlane ios submit          wait for Apple's processing, then submit for review
#   fastlane android release     upload the signed .aab to the production track

require "open3"
require "securerandom"
require "tmpdir"

default_platform(:ios)

IOS_BUNDLE_ID = @@ruby:ios.bundleId@@
IOS_TEAM_ID = @@ruby:ios.teamId@@
IOS_XCODEPROJ = @@ruby:ios.xcodeproj@@
IOS_WORKSPACE = @@ruby:ios.workspace@@ # empty when the project has no CocoaPods workspace
IOS_SCHEME = @@ruby:ios.scheme@@
IOS_TARGET = @@ruby:ios.target@@
IOS_IPA = "build/ios/app.ipa"
IOS_USES_NON_EXEMPT_ENCRYPTION = @@release.iosUsesNonExemptEncryption@@
ANDROID_PACKAGE = @@ruby:android.packageName@@
ANDROID_AAB = @@ruby:android.aab@@
ANDROID_BUILD_OUTPUTS = File.dirname(File.dirname(File.dirname(ANDROID_AAB))) # .../app/build/outputs
DEFAULT_RELEASE_NOTES = @@ruby:release.defaultNotes@@

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
    is_key_content_base64: true
  )
end

def play_json_key
  ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON")
end

def secret_file(name, env_var)
  path = File.join(ENV.fetch("RUNNER_TEMP", Dir.tmpdir), name)
  File.binwrite(path, ENV.fetch(env_var).unpack1("m"))
  path
end

def with_retries(what, attempts: 3)
  tries = 0
  begin
    tries += 1
    yield
  rescue StandardError => e
    raise if tries >= attempts

    # App Store Connect's upload endpoint returns transient 5xx errors now and then.
    UI.important("#{what} failed (attempt #{tries}/#{attempts}): #{e.message}. Retrying in 30s...")
    sleep(30)
    retry
  end
end

# The text of an annotated tag (git tag -a v1.2.3 -m "..."), or DEFAULT_RELEASE_NOTES.
def release_notes
  tag = ENV["GITHUB_REF_NAME"].to_s
  return DEFAULT_RELEASE_NOTES if tag.empty?

  # actions/checkout turns the pushed tag into a lightweight one: fetch the real tag object.
  Open3.capture2e("git", "fetch", "--force", "--quiet", "origin", "+refs/tags/#{tag}:refs/tags/#{tag}")
  type, = Open3.capture2("git", "cat-file", "-t", "refs/tags/#{tag}")
  return DEFAULT_RELEASE_NOTES unless type.strip == "tag"

  text, = Open3.capture2("git", "for-each-ref", "--format=%(contents:subject)%0a%0a%(contents:body)", "refs/tags/#{tag}")
  text = text.strip
  text.empty? ? DEFAULT_RELEASE_NOTES : text[0, 4000]
end

desc "Print the next build number: the highest either store has seen, plus one"
lane :next_build_number do
  ios = latest_testflight_build_number(
    api_key: asc_api_key,
    app_identifier: IOS_BUNDLE_ID,
    initial_build_number: 0
  ).to_i

  errors = []
  codes = %w[production beta alpha internal].flat_map do |track|
    google_play_track_version_codes(package_name: ANDROID_PACKAGE, track: track, json_key_data: play_json_key)
  rescue StandardError => e
    errors << "#{track}: #{e.message}"
    []
  end
  if errors.length == 4
    UI.user_error!("Google Play did not answer for #{ANDROID_PACKAGE}:\n  #{errors.join("\n  ")}\n" \
                   "Check the GOOGLE_PLAY_SERVICE_ACCOUNT_JSON secret, the service account's access in Play Console, " \
                   "and that the first .aab was uploaded by hand.")
  end
  android = codes.map(&:to_i).max.to_i

  next_number = [ios, android].max + 1
  UI.success("Latest build number: App Store #{ios}, Google Play #{android}. This release: #{next_number}")
  File.write(ENV["GITHUB_OUTPUT"], "build_number=#{next_number}\n", mode: "a") if ENV["GITHUB_OUTPUT"]
  next_number
end

# A temporary keychain with the distribution certificate, and an App Store profile: the one in
# IOS_PROVISIONING_PROFILE when set, otherwise one fetched (or created) with the API key.
# Returns the profile's name.
def install_ios_signing(api_key)
  keychain = "mobile-cicd.keychain"
  keychain_password = SecureRandom.hex(24)
  create_keychain(
    name: keychain,
    password: keychain_password,
    default_keychain: true,
    unlock: true,
    timeout: 3600,
    lock_when_sleeps: false
  )
  import_certificate(
    certificate_path: secret_file("distribution.p12", "IOS_DISTRIBUTION_CERTIFICATE"),
    certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"),
    keychain_name: keychain,
    keychain_password: keychain_password
  )

  if ENV["IOS_PROVISIONING_PROFILE"].to_s.empty?
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: IOS_BUNDLE_ID,
      team_id: IOS_TEAM_ID,
      output_path: "build/signing"
    )
    lane_context[SharedValues::SIGH_NAME]
  else
    path = secret_file("app.mobileprovision", "IOS_PROVISIONING_PROFILE")
    install_provisioning_profile(path: path)
    FastlaneCore::ProvisioningProfile.name(path)
  end
end

platform :ios do
  desc "Sign, build and upload the .ipa to App Store Connect"
  lane :release do
    api_key = asc_api_key
    profile_name = install_ios_signing(api_key)

    update_code_signing_settings(
      path: IOS_XCODEPROJ,
      use_automatic_signing: false,
      team_id: IOS_TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: IOS_BUNDLE_ID,
      targets: [IOS_TARGET],
      build_configurations: ["Release"]
    )

    build = {
      scheme: IOS_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { IOS_BUNDLE_ID => profile_name } },
      output_directory: File.dirname(IOS_IPA),
      output_name: File.basename(IOS_IPA),
      clean: true
    }
    IOS_WORKSPACE.empty? ? build[:project] = IOS_XCODEPROJ : build[:workspace] = IOS_WORKSPACE
    build_app(build)

    with_retries("Upload to App Store Connect") do
      upload_to_testflight(
        api_key: api_key,
        ipa: IOS_IPA,
        skip_waiting_for_build_processing: true,
        distribute_external: false
      )
    end
  end

  desc "Wait for Apple to process the build, then submit it for review (IOS_SUBMIT_FOR_REVIEW)"
  lane :submit do
    unless ENV["IOS_SUBMIT_FOR_REVIEW"] == "true"
      UI.important("IOS_SUBMIT_FOR_REVIEW is not 'true': the build is in App Store Connect; submit it there by hand.")
      next
    end

    api_key = asc_api_key
    version = ENV.fetch("VERSION")
    build_number = ENV.fetch("BUILD_NUMBER")
    app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
    UI.user_error!("No app with bundle ID #{IOS_BUNDLE_ID} in App Store Connect") unless app

    deadline = Time.now + (60 * 60)
    loop do
      build = Spaceship::ConnectAPI::Build.all(
        app_id: app.id, version: version, build_number: build_number, platform: Spaceship::ConnectAPI::Platform::IOS
      ).first
      state = build&.processing_state
      break if state == "VALID"
      UI.user_error!("Apple could not process build #{build_number} (#{state}). Check the email Apple sent.") if %w[FAILED INVALID].include?(state)
      UI.user_error!("Build #{build_number} was still processing after an hour; submit it by hand in App Store Connect.") if Time.now > deadline

      UI.message("Build #{build_number}: #{state || 'not visible yet'}. Checking again in 30s...")
      sleep(30)
    end

    # "What's New" cannot be set on an app's very first version.
    first_version = app.get_live_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS).nil?
    submit = {
      api_key: api_key,
      app_identifier: IOS_BUNDLE_ID,
      platform: "ios",
      app_version: version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: first_version,
      submit_for_review: true,
      automatic_release: ENV["IOS_AUTOMATIC_RELEASE"] == "true",
      submission_information: { export_compliance_uses_encryption: IOS_USES_NON_EXEMPT_ENCRYPTION },
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true
    }
    submit[:release_notes] = { "default" => release_notes } unless first_version
    upload_to_app_store(submit)
  end
end

platform :android do
  desc "Upload the signed .aab to the production track (ANDROID_ROLLOUT)"
  lane :release do
    rollout = ENV.fetch("ANDROID_ROLLOUT", "1.0").to_f
    params = {
      package_name: ANDROID_PACKAGE,
      track: "production",
      aab: ANDROID_AAB,
      json_key_data: play_json_key,
      release_status: rollout < 1.0 ? "inProgress" : "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    }
    params[:rollout] = rollout.to_s if rollout < 1.0
    mapping = File.join(ANDROID_BUILD_OUTPUTS, "mapping/release/mapping.txt")
    params[:mapping] = mapping if File.exist?(mapping)
    symbols = File.join(ANDROID_BUILD_OUTPUTS, "native-debug-symbols/release/native-debug-symbols.zip")
    params[:debug_symbols] = symbols if File.exist?(symbols)

    begin
      upload_to_play_store(params)
    rescue StandardError => e
      raise unless e.message.include?("draft app")

      # Until the app's first release is published, Google Play only accepts draft releases.
      UI.important("Google Play still lists #{ANDROID_PACKAGE} as a draft app, so the release goes up as a draft. " \
                   "Finish the first release in Play Console; later releases go out by themselves.")
      upload_to_play_store(params.merge(release_status: "draft").tap { |p| p.delete(:rollout) })
    end
  end
end
